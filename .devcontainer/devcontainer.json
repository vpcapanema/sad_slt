{
  "name": "SICARD",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "containerEnv": {
    "GIT_LFS_SKIP_SMUDGE": "1"
  },
  "postCreateCommand": "bash scripts/install-codespace-powershell.sh",
  "postStartCommand": "bash scripts/start-storage-codespace.sh",
  "forwardPorts": [
    8083
  ],
  "portsAttributes": {
    "8083": {
      "label": "SICARD · Servidor local",
      "onAutoForward": "silent"
    },
    "10022": {
      "label": "SICARD · Ponte SSH privada",
      "onAutoForward": "ignore"
    },
    "15433": {
      "label": "SICARD · Banco SLT/SIGMA privado",
      "onAutoForward": "ignore"
    }
  }
}
