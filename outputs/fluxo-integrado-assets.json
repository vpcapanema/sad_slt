6\"}:host,:root{--fa-font-regular:normal 400 1em/1 \"Font Awesome 6 Free\"}@font-face{font-family:\"Font Awesome 6 Free\";font-style:normal;font-weight:400;font-display:block;src:url(../webfonts/fa-regular-400.woff2) format(\"woff2\"),url(../webfonts/fa-regular-400.ttf) format(\"truetype\")}.fa-regular,.far{font-weight:400}:host,:root{--fa-style-family-classic:\"Font Awesome 6 Free\";--fa-font-solid:normal 900 1em/1 \"Font Awesome 6 Free\"}@font-face{font-family:\"Font Awesome 6 Free\";font-style:normal;font-weight:900;font-display:block;src:url(../webfonts/fa-solid-900.woff2) format(\"woff2\"),url(../webfonts/fa-solid-900.ttf) format(\"truetype\")}.fa-solid,.fas{font-weight:900}@font-face{font-family:\"Font Awesome 5 Brands\";font-display:block;font-weight:400;src:url(../webfonts/fa-brands-400.woff2) format(\"woff2\"),url(../webfonts/fa-brands-400.ttf) format(\"truetype\")}@font-face{font-family:\"Font Awesome 5 Free\";font-display:block;font-weight:900;src:url(../webfonts/fa-solid-900.woff2) format(\"woff2\"),url(../webfonts/fa-solid-900.ttf) format(\"truetype\")}@font-face{font-family:\"Font Awesome 5 Free\";font-display:block;font-weight:400;src:url(../webfonts/fa-regular-400.woff2) format(\"woff2\"),url(../webfonts/fa-regular-400.ttf) format(\"truetype\")}@font-face{font-family:\"FontAwesome\";font-display:block;src:url(../webfonts/fa-solid-900.woff2) format(\"woff2\"),url(../webfonts/fa-solid-900.ttf) format(\"truetype\")}@font-face{font-family:\"FontAwesome\";font-display:block;src:url(../webfonts/fa-brands-400.woff2) format(\"woff2\"),url(../webfonts/fa-brands-400.ttf) format(\"truetype\")}@font-face{font-family:\"FontAwesome\";font-display:block;src:url(../webfonts/fa-regular-400.woff2) format(\"woff2\"),url(../webfonts/fa-regular-400.ttf) format(\"truetype\");unicode-range:u+f003,u+f006,u+f014,u+f016-f017,u+f01a-f01b,u+f01d,u+f022,u+f03e,u+f044,u+f046,u+f05c-f05d,u+f06e,u+f070,u+f087-f088,u+f08a,u+f094,u+f096-f097,u+f09d,u+f0a0,u+f0a2,u+f0a4-f0a7,u+f0c5,u+f0c7,u+f0e5-f0e6,u+f0eb,u+f0f6-f0f8,u+f10c,u+f114-f115,u+f118-f11a,u+f11c-f11d,u+f133,u+f147,u+f14e,u+f150-f152,u+f185-f186,u+f18e,u+f190-f192,u+f196,u+f1c1-f1c9,u+f1d9,u+f1db,u+f1e3,u+f1ea,u+f1f7,u+f1f9,u+f20a,u+f247-f248,u+f24a,u+f24d,u+f255-f25b,u+f25d,u+f271-f274,u+f278,u+f27b,u+f28c,u+f28e,u+f29c,u+f2b5,u+f2b7,u+f2ba,u+f2bc,u+f2be,u+f2c0-f2c1,u+f2c3,u+f2d0,u+f2d2,u+f2d4,u+f2dc}@font-face{font-family:\"FontAwesome\";font-display:block;src:url(../webfonts/fa-v4compatibility.woff2) format(\"woff2\"),url(../webfonts/fa-v4compatibility.ttf) format(\"truetype\");unicode-range:u+f041,u+f047,u+f065-f066,u+f07d-f07e,u+f080,u+f08b,u+f08e,u+f090,u+f09a,u+f0ac,u+f0ae,u+f0b2,u+f0d0,u+f0d6,u+f0e4,u+f0ec,u+f10a-f10b,u+f123,u+f13e,u+f148-f149,u+f14c,u+f156,u+f15e,u+f160-f161,u+f163,u+f175-f178,u+f195,u+f1f8,u+f219,u+f27a}",
  "http://127.0.0.1:8083/assets/css/process_feedback_system.css?v=20261027-erro-blocos": "/**\r\n * Process Feedback System (SIGMA-PLI v3) — estilos reconstruídos para o SICARD.\r\n * Estrutura e comportamento do SIGMA-PLI: overlay de progresso com tarefas,\r\n * modais de resultado (sucesso, parcial, erro), confirmação e credencial.\r\n * Paleta PLI do SICARD, com semáforo nos cabeçalhos: azul em andamento,\r\n * verde sucesso, amarelo parcial, vermelho erro.\r\n */\r\n:root {\r\n  --pfs-navy: var(--pli-navy, #1c3d59);\r\n  --pfs-deep: var(--pli-deep, #003b5a);\r\n  --pfs-blue: var(--pli-blue, #116593);\r\n  --pfs-green: var(--pli-green, #3ec26e);\r\n  --pfs-green-dark: #187b43;\r\n  --pfs-green-light: #dcf5e6;\r\n  --pfs-amber: #b98900;\r\n  --pfs-amber-dark: #7a5500;\r\n  --pfs-amber-light: #fdf3d3;\r\n  --pfs-red: var(--pli-error, #c0392b);\r\n  --pfs-red-dark: #8e2a20;\r\n  --pfs-red-light: #fbe4e1;\r\n  --pfs-info-light: #e3f0f7;\r\n  --pfs-gray-100: #f3f6f8;\r\n  --pfs-gray-200: #dfe6eb;\r\n  --pfs-gray-500: #5a6570;\r\n  --pfs-gray-700: #2c3e4c;\r\n  --pfs-gray-900: #12242f;\r\n  --pfs-white: #fff;\r\n}\r\n\r\n/* ── Overlays ── */\r\n.pfs-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 30000;\r\n  display: none;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 16px;\r\n  background: rgba(240, 240, 241, 0.88);\r\n  -webkit-backdrop-filter: blur(12px);\r\n  backdrop-filter: blur(12px);\r\n}\r\n.pfs-overlay.pfs-active { display: flex; }\r\n/* Resultado e decisão ficam acima do progresso. */\r\n#pfsStatusOverlay { z-index: 30010; }\r\n#pfsConfirmOverlay, #pfsCredentialOverlay { z-index: 30020; }\r\n\r\n.pfs-box {\r\n  display: none;\r\n  flex-direction: column;\r\n  width: min(600px, 100%);\r\n  max-height: 90vh;\r\n  overflow: hidden;\r\n  background: var(--pfs-white);\r\n  border-radius: 16px;\r\n  box-shadow: 0 25px 50px -12px rgba(0, 59, 90, 0.28);\r\n}\r\n.pfs-box.pfs-active { display: flex; animation: pfsSlideIn 0.35s ease both; }\r\n.pfs-box:focus { outline: none; }\r\n@keyframes pfsSlideIn { from { opacity: 0; transform: translateY(24px) scale(0.97); } to { opacity: 1; transform: none; } }\r\n\r\n/* ── Cabeçalho (semáforo) ── */\r\n.pfs-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 18px 22px;\r\n  flex-shrink: 0;\r\n  color: var(--pfs-white);\r\n  background: linear-gradient(135deg, var(--pfs-navy) 0%, var(--pfs-blue) 100%);\r\n}\r\n.pfs-header--success { background: linear-gradient(135deg, var(--pfs-green-dark) 0%, #2aa358 100%); }\r\n.pfs-header--partial { background: linear-gradient(135deg, var(--pfs-amber-dark) 0%, var(--pfs-amber) 100%); }\r\n.pfs-header--error { background: linear-gradient(135deg, var(--pfs-red-dark) 0%, var(--pfs-red) 100%); }\r\n.pfs-header-icon {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  width: 46px;\r\n  height: 46px;\r\n  border-radius: 12px;\r\n  background: rgba(255, 255, 255, 0.2);\r\n  font-size: 22px;\r\n}\r\n.pfs-header-text { flex: 1; min-width: 0; }\r\n.pfs-header-text h3 { margin: 0; font-size: 1.1rem; font-weight: 600; line-height: 1.3; color: inherit; }\r\n.pfs-header-text p { margin: 3px 0 0; font-size: 0.82rem; opacity: 0.9; overflow-wrap: anywhere; }\r\n.pfs-header-text p:empty { display: none; }\r\n.pfs-close {\r\n  flex-shrink: 0;\r\n  width: 34px;\r\n  height: 34px;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  background: rgba(255, 255, 255, 0.15);\r\n  color: inherit;\r\n  font-size: 1rem;\r\n  cursor: pointer;\r\n}\r\n.pfs-close:hover, .pfs-close:focus-visible { background: rgba(255, 255, 255, 0.3); }\r\n\r\n.pfs-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 20px 22px; }\r\n.pfs-hidden { display: none !important; }\r\n\r\n/* ── Progresso: tarefa atual ── */\r\n.pfs-task-card {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  margin-bottom: 12px;\r\n  padding: 14px 18px;\r\n  border: 1px solid #c3dbe8;\r\n  border-radius: 10px;\r\n  background: linear-gradient(135deg, #eef6fa 0%, var(--pfs-info-light) 100%);\r\n}\r\n.pfs-task-card-enter { animation: pfsTaskIn 0.35s ease; }\r\n@keyframes pfsTaskIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }\r\n.pfs-task-step { display: flex; flex-direction: column; align-items: center; min-width: 42px; }\r\n.pfs-task-step-num { font-size: 22px; font-weight: 700; line-height: 1; color: var(--pfs-blue); }\r\n.pfs-task-step-total { margin-top: 2px; font-size: 11px; color: var(--pfs-gray-500); }\r\n.pfs-task-info { flex: 1; min-width: 0; }\r\n.pfs-task-name { font-size: 14px; font-weight: 600; line-height: 1.3; color: var(--pfs-deep); overflow-wrap: anywhere; }\r\n.pfs-task-desc { margin-top: 3px; font-size: 12px; line-height: 1.4; color: var(--pfs-gray-500); white-space: pre-line; }\r\n.pfs-task-desc:empty { display: none; }\r\n.pfs-task-spinner { flex-shrink: 0; font-size: 20px; color: var(--pfs-blue); }\r\n\r\n/* ── Progresso: tarefas concluídas ── */\r\n.pfs-completed-list { display: flex; flex-direction: column; gap: 4px; margin-bottom: 8px; }\r\n.pfs-completed-list:empty { display: none; }\r\n.pfs-completed-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 6px 12px;\r\n  border: 1px solid #bfe8cf;\r\n  border-radius: 6px;\r\n  background: #f0fbf4;\r\n  font-size: 12px;\r\n  animation: pfsDoneIn 0.3s ease;\r\n}\r\n@keyframes pfsDoneIn { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }\r\n.pfs-completed-check { flex-shrink: 0; font-size: 14px; color: var(--pfs-green-dark); }\r\n.pfs-completed-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; color: #134e2c; }\r\n.pfs-completed-msg { flex-shrink: 0; max-width: 45%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; color: var(--pfs-green-dark); }\r\n\r\n/* ── Progresso: log ── */\r\n.pfs-log {\r\n  max-height: 260px;\r\n  overflow-y: auto;\r\n  padding: 14px 16px;\r\n  border: 1px solid var(--pfs-gray-200);\r\n  border-radius: 8px;\r\n  background: var(--pfs-gray-100);\r\n  color: var(--pfs-gray-700);\r\n  font-family: Consolas, Monaco, \"Courier New\", monospace;\r\n  font-size: 12px;\r\n  line-height: 1.6;\r\n}\r\n.pfs-log:empty { display: none; }\r\n.pfs-log::-webkit-scrollbar { width: 6px; }\r\n.pfs-log::-webkit-scrollbar-thumb { background: #9fb1bd; border-radius: 3px; }\r\n.pfs-log-entry { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 5px; animation: pfsLogIn 0.25s ease; }\r\n@keyframes pfsLogIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: none; } }\r\n.pfs-log-time { flex-shrink: 0; font-size: 11px; color: var(--pfs-gray-500); }\r\n.pfs-log-icon { flex-shrink: 0; width: 16px; text-align: center; }\r\n.pfs-log-msg { flex: 1; min-width: 0; overflow-wrap: anywhere; white-space: pre-line; }\r\n.pfs-log-entry--task-start { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--pfs-gray-200); font-weight: 600; color: var(--pfs-blue); }\r\n.pfs-log-entry--task-start:first-child { margin-top: 0; padding-top: 0; border-top: 0; }\r\n.pfs-log-entry--step { color: var(--pfs-gray-700); }\r\n.pfs-log-entry--success { color: var(--pfs-green-dark); }\r\n.pfs-log-entry--error { color: var(--pfs-red); }\r\n.pfs-log-entry--warning { color: var(--pfs-amber-dark); }\r\n.pfs-log-entry--info { color: var(--pfs-deep); }\r\n.pfs-log-spinner {\r\n  display: inline-block;\r\n  width: 12px;\r\n  height: 12px;\r\n  border: 2px solid var(--pfs-blue);\r\n  border-right-color: transparent;\r\n  border-radius: 50%;\r\n  animation: pfsSpin 0.6s linear infinite;\r\n}\r\n@keyframes pfsSpin { to { transform: rotate(360deg); } }\r\n\r\n/* ── Progresso: rodapé e barra ── */\r\n.pfs-progress-footer { display: flex; justify-content: center; padding: 0 22px 12px; }\r\n.pfs-progress-footer:has(> [hidden]:only-child) { display: none; }\r\n.pfs-progress-wrapper { flex-shrink: 0; padding: 4px 22px 20px; }\r\n.pfs-progress-info { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-size: 12px; color: var(--pfs-gray-500); }\r\n.pfs-progress-percent { font-weight: 600; color: var(--pfs-blue); }\r\n.pfs-progress-bar { position: relative; height: 8px; overflow: hidden; border-radius: 4px; background: var(--pfs-gray-200); }\r\n.pfs-progress-fill {\r\n  position: relative;\r\n  width: 0;\r\n  height: 100%;\r\n  border-radius: 4px;\r\n  background: linear-gradient(90deg, var(--pfs-navy) 0%, var(--pfs-blue) 100%);\r\n  transition: width 0.3s ease;\r\n}\r\n.pfs-progress-fill::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);\r\n  animation: pfsShine 1.5s ease infinite;\r\n}\r\n@keyframes pfsShine { from { transform: translateX(-100%); } to { transform: translateX(100%); } }\r\n.pfs-segments { display: flex; gap: 2px; margin-top: 6px; }\r\n.pfs-segment { flex: 1; height: 4px; border-radius: 2px; background: var(--pfs-gray-200); transition: background 0.3s ease; }\r\n.pfs-segment--completed { background: var(--pfs-green); }\r\n.pfs-segment--active { background: var(--pfs-amber); animation: pfsPulse 1s ease infinite; }\r\n.pfs-segment--error { background: var(--pfs-red); }\r\n@keyframes pfsPulse { 50% { opacity: 0.55; } }\r\n\r\n/* ── Resultado: sucesso e parcial ── */\r\n.pfs-result-content { padding: 12px 0 4px; text-align: center; }\r\n.pfs-result-icon {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 76px;\r\n  height: 76px;\r\n  margin: 0 auto 18px;\r\n  border-radius: 50%;\r\n  font-size: 36px;\r\n  background: var(--pfs-green-light);\r\n  color: var(--pfs-green-dark);\r\n  animation: pfsBounce 0.6s ease;\r\n}\r\n.pfs-result-icon--partial { background: var(--pfs-amber-light); color: var(--pfs-amber-dark); }\r\n@keyframes pfsBounce { 0% { transform: scale(0); } 50% { transform: scale(1.2); } 100% { transform: scale(1); } }\r\n.pfs-result-title { margin: 0 0 8px; font-size: 1.35rem; font-weight: 700; color: var(--pfs-deep); }\r\n.pfs-result-message { margin: 0 0 20px; font-size: 0.9rem; line-height: 1.5; color: var(--pfs-deep); white-space: pre-line; overflow-wrap: anywhere; }\r\n\r\n.pfs-file-summary { margin-bottom: 16px; padding: 12px 18px; border-radius: 10px; background: var(--pfs-gray-100); text-align: left; }\r\n.pfs-file-row { display: flex; align-items: baseline; gap: 8px; padding: 5px 0; border-bottom: 1px solid rgba(0, 0, 0, 0.05); font-size: 13px; }\r\n.pfs-file-row:last-child { border-bottom: 0; }\r\n.pfs-file-label { display: flex; align-items: center; gap: 6px; flex-shrink: 0; min-width: 110px; max-width: 45%; font-size: 12px; color: var(--pfs-gray-500); }\r\n.pfs-file-label i { width: 14px; text-align: center; color: var(--pfs-blue); }\r\n.pfs-file-value { font-weight: 600; color: var(--pfs-gray-900); overflow-wrap: anywhere; white-space: pre-line; }\r\n\r\n/* ── Resultado: subprocessos ── */\r\n.pfs-subprocess-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; text-align: left; }\r\n.pfs-subprocess-list:empty { display: none; }\r\n.pfs-sp-item {\r\n  display: grid;\r\n  grid-template-columns: 28px 1fr 20px;\r\n  grid-template-rows: auto auto;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  padding: 10px 14px;\r\n  border: 1px solid;\r\n  border-radius: 8px;\r\n  animation: pfsSpIn 0.3s ease both;\r\n}\r\n@keyframes pfsSpIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\r\n.pfs-sp-icon { display: flex; align-items: center; justify-content: center; grid-row: 1 / -1; width: 28px; height: 28px; border-radius: 6px; font-size: 14px; }\r\n.pfs-sp-name { grid-column: 2; font-size: 13px; font-weight: 600; overflow-wrap: anywhere; }\r\n.pfs-sp-status { grid-column: 3; grid-row: 1; font-size: 14px; text-align: center; }\r\n.pfs-sp-detail { grid-column: 2 / 4; font-size: 12px; opacity: 0.85; white-space: pre-line; overflow-wrap: anywhere; }\r\n.pfs-sp-action-btn {\r\n  grid-column: 2 / 4;\r\n  justify-self: start;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  margin-top: 8px;\r\n  padding: 8px 14px;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  background: var(--pfs-blue);\r\n  color: #fff;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  text-decoration: none;\r\n  cursor: pointer;\r\n}\r\n.pfs-sp-action-btn:hover, .pfs-sp-action-btn:focus-visible { background: var(--pfs-deep); color: #fff; }\r\n.pfs-sp--success { background: #f0fbf4; border-color: #bfe8cf; }\r\n.pfs-sp--success .pfs-sp-icon { background: var(--pfs-green-light); color: var(--pfs-green-dark); }\r\n.pfs-sp--success .pfs-sp-name, .pfs-sp--success .pfs-sp-detail { color: #134e2c; }\r\n.pfs-sp--success .pfs-sp-status { color: var(--pfs-green-dark); }\r\n.pfs-sp--warning { background: #fffaeb; border-color: #f2dc8c; }\r\n.pfs-sp--warning .pfs-sp-icon { background: var(--pfs-amber-light); color: var(--pfs-amber-dark); }\r\n.pfs-sp--warning .pfs-sp-name, .pfs-sp--warning .pfs-sp-detail, .pfs-sp--warning .pfs-sp-status { color: var(--pfs-amber-dark); }\r\n.pfs-sp--skip { background: var(--pfs-gray-100); border-color: var(--pfs-gray-200); }\r\n.pfs-sp--skip .pfs-sp-icon { background: var(--pfs-gray-200); }\r\n.pfs-sp--skip .pfs-sp-icon, .pfs-sp--skip .pfs-sp-name, .pfs-sp--skip .pfs-sp-status, .pfs-sp--skip .pfs-sp-detail { color: var(--pfs-gray-500); }\r\n.pfs-sp--error { background: #fdf2f1; border-color: #f2c4bf; }\r\n.pfs-sp--error .pfs-sp-icon { background: var(--pfs-red-light); color: var(--pfs-red); }\r\n.pfs-sp--error .pfs-sp-name, .pfs-sp--error .pfs-sp-detail { color: var(--pfs-red-dark); }\r\n.pfs-sp--error .pfs-sp-status { color: var(--pfs-red); }\r\n\r\n/* ── Resultado: erro ── */\r\n.pfs-error-icon {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 76px;\r\n  height: 76px;\r\n  margin: 0 auto 18px;\r\n  border-radius: 50%;\r\n  background: var(--pfs-red-light);\r\n  color: var(--pfs-red);\r\n  font-size: 36px;\r\n  animation: pfsShake 0.6s ease;\r\n}\r\n@keyframes pfsShake { 0%, 100% { transform: none; } 20%, 60% { transform: translateX(-8px); } 40%, 80% { transform: translateX(8px); } }\r\n.pfs-error-title { margin: 0 0 8px; font-size: 1.35rem; font-weight: 700; color: var(--pfs-red-dark); }\r\n.pfs-error-message { margin: 0 0 18px; font-size: 0.9rem; line-height: 1.5; color: var(--pfs-gray-700); white-space: pre-line; overflow-wrap: anywhere; }\r\n.pfs-error-message:empty { display: none; }\r\n.pfs-error-technical {\r\n  margin: -6px 0 18px;\r\n  padding: 10px 12px;\r\n  border-radius: 6px;\r\n  background: #f1f3f5;\r\n  color: #52606d;\r\n  font-family: Consolas, \"Courier New\", monospace;\r\n  font-size: 0.75rem;\r\n  line-height: 1.5;\r\n  text-align: left;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n.pfs-error-technical[hidden] { display: none; }\r\n.pfs-error-details { margin-bottom: 14px; padding: 14px 16px; border-radius: 12px; background: var(--pfs-gray-100); text-align: left; }\r\n.pfs-error-details:has(.pfs-error-log:empty) { display: none; }\r\n.pfs-error-details-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font-size: 14px; font-weight: 600; color: var(--pfs-red); }\r\n.pfs-error-log {\r\n  max-height: 150px;\r\n  overflow-y: auto;\r\n  padding: 12px;\r\n  border: 1px solid var(--pfs-gray-200);\r\n  border-radius: 8px;\r\n  background: #fafcfd;\r\n  color: var(--pfs-gray-700);\r\n  font-family: Consolas, Monaco, \"Courier New\", monospace;\r\n  font-size: 12px;\r\n  line-height: 1.6;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n.pfs-solution { padding: 12px 16px; border-left: 4px solid var(--pfs-blue); border-radius: 0 8px 8px 0; background: var(--pfs-info-light); text-align: left; }\r\n.pfs-solution-title { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--pfs-blue); }\r\n.pfs-solution-text { margin: 0; font-size: 13px; color: var(--pfs-gray-700); }\r\n\r\n/* ── Rodapé e botões ── */\r\n.pfs-footer { display: flex; flex-shrink: 0; flex-wrap: wrap; justify-content: center; gap: 12px; padding: 16px 22px; border-top: 1px solid var(--pfs-gray-200); }\r\n.pfs-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 11px 28px;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: var(--pfs-white);\r\n  cursor: pointer;\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n.pfs-btn:hover { transform: translateY(-2px); }\r\n.pfs-btn:focus-visible { outline: 3px solid rgba(17, 101, 147, 0.45); outline-offset: 2px; }\r\n.pfs-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }\r\n.pfs-btn--primary { background: linear-gradient(135deg, var(--pfs-navy) 0%, var(--pfs-blue) 100%); }\r\n.pfs-btn--primary:hover { box-shadow: 0 4px 12px rgba(17, 101, 147, 0.4); }\r\n.pfs-btn--success { background: linear-gradient(135deg, var(--pfs-green-dark) 0%, #2aa358 100%); }\r\n.pfs-btn--success:hover { box-shadow: 0 4px 12px rgba(42, 163, 88, 0.4); }\r\n.pfs-btn--partial { background: linear-gradient(135deg, var(--pfs-amber-dark) 0%, var(--pfs-amber) 100%); }\r\n.pfs-btn--partial:hover { box-shadow: 0 4px 12px rgba(185, 137, 0, 0.4); }\r\n.pfs-btn--error, .pfs-btn--cancel { background: linear-gradient(135deg, var(--pfs-red-dark) 0%, var(--pfs-red) 100%); }\r\n.pfs-btn--error:hover, .pfs-btn--cancel:hover { box-shadow: 0 4px 12px rgba(192, 57, 43, 0.4); }\r\n.pfs-btn--secondary { background: var(--pfs-white); color: var(--pfs-gray-700); border: 1px solid var(--pfs-gray-200); }\r\n.pfs-btn--secondary:hover { background: var(--pfs-gray-100); }\r\n\r\n/* ── Confirmação ── */\r\n.pfs-confirm-box { width: min(520px, 100%); }\r\n.pfs-confirm-body { text-align: center; }\r\n.pfs-confirm-message { margin: 0 0 12px; font-size: 0.95rem; line-height: 1.5; color: var(--pfs-gray-900); white-space: pre-line; overflow-wrap: anywhere; }\r\n.pfs-confirm-warning {\r\n  margin: 0 0 12px;\r\n  padding: 10px 14px;\r\n  border-left: 4px solid var(--pfs-amber);\r\n  border-radius: 0 8px 8px 0;\r\n  background: var(--pfs-amber-light);\r\n  color: var(--pfs-amber-dark);\r\n  font-size: 0.85rem;\r\n  line-height: 1.5;\r\n  text-align: left;\r\n  white-space: pre-line;\r\n  overflow-wrap: anywhere;\r\n}\r\n.pfs-confirm-warning:empty, .pfs-confirm-message:empty, .pfs-confirm-prompt:empty { display: none; }\r\n.pfs-confirm-prompt { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--pfs-deep); }\r\n.pfs-confirm-input-wrap { display: none; margin-top: 12px; text-align: left; }\r\n.pfs-confirm-input-wrap.pfs-active { display: block; }\r\n.pfs-confirm-input, .pfs-credential-input {\r\n  width: 100%;\r\n  padding: 10px 12px;\r\n  border: 1px solid #b8c7d1;\r\n  border-radius: 8px;\r\n  font-size: 0.95rem;\r\n  color: var(--pfs-gray-900);\r\n  box-sizing: border-box;\r\n}\r\n.pfs-confirm-input:focus, .pfs-credential-input:focus { outline: 3px solid rgba(17, 101, 147, 0.3); border-color: var(--pfs-blue); }\r\n\r\n/* ── Credencial (gestor/admin) ── */\r\n.pfs-credential-header--gestor { background: linear-gradient(135deg, var(--pfs-navy) 0%, var(--pfs-blue) 100%); }\r\n.pfs-credential-header--admin { background: linear-gradient(135deg, var(--pfs-red-dark) 0%, var(--pfs-red) 100%); }\r\n.pfs-credential-body { text-align: center; }\r\n.pfs-credential-icon-area { display: flex; align-items: center; justify-content: center; width: 72px; height: 72px; margin: 0 auto 12px; border-radius: 50%; font-size: 32px; }\r\n.pfs-credential-icon-area--gestor { background: var(--pfs-info-light); color: var(--pfs-blue); }\r\n.pfs-credential-icon-area--admin { background: var(--pfs-red-light); color: var(--pfs-red); }\r\n.pfs-credential-restricted-label { margin: 0 0 8px; font-size: 1.1rem; font-weight: 700; }\r\n.pfs-credential-restricted-label--gestor { color: var(--pfs-blue); }\r\n.pfs-credential-restricted-label--admin { color: var(--pfs-red); }\r\n.pfs-credential-message { margin: 0 0 16px; font-size: 0.9rem; line-height: 1.5; color: var(--pfs-gray-700); white-space: pre-line; }\r\n.pfs-credential-field { text-align: left; }\r\n.pfs-credential-field label { display: block; margin-bottom: 6px; font-size: 0.85rem; font-weight: 600; color: var(--pfs-gray-700); }\r\n.pfs-credential-input--admin:focus { outline-color: rgba(192, 57, 43, 0.3); border-color: var(--pfs-red); }\r\n.pfs-credential-error { min-height: 1.2em; margin: 6px 0 0; font-size: 0.82rem; color: var(--pfs-red); text-align: left; }\r\n.pfs-btn--credential-ok--gestor { background: linear-gradient(135deg, var(--pfs-navy) 0%, var(--pfs-blue) 100%); }\r\n.pfs-btn--credential-ok--admin { background: linear-gradient(135deg, var(--pfs-red-dark) 0%, var(--pfs-red) 100%); }\r\n\r\n@media (max-width: 640px) {\r\n  .pfs-header { padding: 14px 16px; }\r\n  .pfs-body { padding: 16px; }\r\n  .pfs-log { max-height: 190px; font-size: 11px; }\r\n  .pfs-footer { padding: 14px 16px; }\r\n  .pfs-btn { padding: 10px 20px; font-size: 13px; }\r\n  .pfs-task-card { gap: 10px; padding: 12px 14px; }\r\n  .pfs-file-row { flex-direction: column; gap: 2px; }\r\n  .pfs-file-label { max-width: none; }\r\n}\r\n@media (prefers-reduced-motion: reduce) {\r\n  .pfs-box.pfs-active, .pfs-task-card-enter, .pfs-completed-item, .pfs-log-entry, .pfs-sp-item,\r\n  .pfs-result-icon, .pfs-error-icon, .pfs-segment--active, .pfs-progress-fill::after { animation: none; }\r\n  .pfs-log-spinner { animation-duration: 1.5s; }\r\n}\r\n\r\n/* Medição da tarefa corrente, separada do progresso geral. */\r\n.pfs-task-progress{padding:0 0 14px;}\r\n.pfs-task-progress .pfs-progress-bar{height:8px;}\r\n.pfs-progress-indeterminate .pfs-progress-fill{width:28%;animation:pfs-indeterminate 1.5s ease-in-out infinite;}\r\n@keyframes pfs-indeterminate{from{transform:translateX(-100%);}to{transform:translateX(400%);}}\r\n@media(prefers-reduced-motion:reduce){.pfs-progress-indeterminate .pfs-progress-fill{animation:none;transform:none;}}\r\n\r\n/* Mensagens prioritárias, resumo acessível e histórico com retenção explícita. */\r\n#pfsProgressBox { width: min(840px, 100%); }\r\n#pfsProgressBox .pfs-task-card { display: none; }\r\n.pfs-current { padding: 12px 14px; border-left: 4px solid var(--pfs-blue); background: var(--pfs-info-light); color: var(--pfs-deep); font-size: 14px; font-weight: 600; line-height: 1.5; white-space: pre-line; overflow-wrap: anywhere; }\r\n.pfs-contact, .pfs-history-note { font-size: 12px; line-height: 1.4; color: var(--pfs-gray-500); margin: 8px 0; }\r\n.pfs-contact:empty, .pfs-history-note:empty { display: none; }\r\n.pfs-log-tools { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }\r\n.pfs-log-tools button { border: 1px solid var(--pfs-gray-200); border-radius: 6px; padding: 8px 10px; background: white; color: var(--pfs-deep); cursor: pointer; }\r\n.pfs-log-tools button[aria-pressed=\"true\"] { background: var(--pfs-info-light); border-color: var(--pfs-blue); }\r\n.pfs-log-tools button:focus-visible, .pfs-completed-details summary:focus-visible, .pfs-log:focus-visible { outline: 3px solid var(--pfs-blue); outline-offset: 2px; }\r\n#pfsProgressBox .pfs-log { max-height: 36vh; min-height: 100px; }\r\n.pfs-completed-details { margin-top: 12px; color: var(--pfs-gray-700); font-size: 12px; }\r\n.pfs-completed-details summary { padding: 8px 0; cursor: pointer; }\r\n.pfs-completed-name, .pfs-completed-msg { white-space: normal; overflow: visible; overflow-wrap: anywhere; }\r\n@media(max-width:640px) { .pfs-current { font-size: 13px; } .pfs-log-tools button { flex: 1; } #pfsProgressBox .pfs-log { max-height: 30vh; } }\r\n\r\n/* Modais compactos: as três famílias mantêm dimensões próprias e corpo rolável. */\