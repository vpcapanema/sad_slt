-filter label{color:var(--pli-deep);font-size:.7rem;font-weight:800}.ami-composite-filter select,.ami-composite-filter input{min-height:2.25rem;padding:.45rem .6rem;border:1px solid var(--pli-border);border-radius:.45rem;background:#fff;font-size:.7rem}.ami-composite-filter span{color:var(--pli-muted);font-size:.68rem;white-space:nowrap}@media(max-width:700px){.ami-composite-filter{grid-template-columns:1fr}.ami-composite-filter label{margin-bottom:-.35rem}}\r\n.ami-ratio{display:inline-grid;justify-items:center;gap:.12rem;min-width:3.8rem}.ami-ratio strong{color:var(--pli-deep);font-size:.72rem;font-variant-numeric:tabular-nums}.ami-ratio small{color:var(--pli-muted);font-size:.62rem}.ami-page #ami-analysis-participation{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.65rem;margin:1rem 0}.ami-page #ami-analysis-participation .ahp-metric-card{min-width:0}.ami-analysis-split{display:grid;grid-template-columns:minmax(18rem,.8fr) minmax(28rem,1.2fr);gap:1.25rem;align-items:start}.ami-analysis-chart{min-width:0;padding:.25rem 0}.ami-bar-chart{display:grid;gap:.7rem}.ami-bar-chart__row{display:grid;grid-template-columns:minmax(7rem,1fr) minmax(8rem,2fr) 4.2rem;gap:.55rem;align-items:center}.ami-bar-chart__label{overflow:hidden;color:var(--pli-deep);font-size:.68rem;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.ami-bar-chart__track{height:.72rem;overflow:hidden;border-radius:999px;background:#e5ebf0}.ami-bar-chart__bar{display:block;height:100%;border-radius:inherit;background:var(--pli-blue)}.ami-bar-chart__row strong{color:var(--pli-deep);font-size:.66rem;font-variant-numeric:tabular-nums;text-align:right}@media(max-width:1100px){.ami-page #ami-analysis-participation{grid-template-columns:repeat(3,minmax(0,1fr))}.ami-analysis-split{grid-template-columns:1fr}}@media(max-width:600px){.ami-page #ami-analysis-participation{grid-template-columns:repeat(2,minmax(0,1fr))}.ami-bar-chart__row{grid-template-columns:minmax(6rem,1fr) minmax(6rem,1.4fr) 3.7rem}}\r\n.ami-page{--ami-chart-1:#1f77b4;--ami-chart-2:#ff7f0e;--ami-chart-3:#2ca02c;--ami-chart-4:#d62728;--ami-chart-5:#9467bd;--ami-chart-6:#17becf;--ami-chart-7:#bcbd22;--ami-chart-8:#e377c2}.ami-analysis-split{grid-template-columns:minmax(0,2fr) minmax(0,3fr)}.ami-analysis-split>.matriz-table-wrap{min-width:0;width:100%;margin:0}.ami-donut-chart{display:grid;grid-template-columns:minmax(9rem,12rem) minmax(10rem,1fr);gap:1rem;align-items:center;margin:0}.ami-donut-chart__plot{display:grid;place-items:center;width:min(100%,12rem);aspect-ratio:1;margin:auto;border-radius:50%;position:relative}.ami-donut-chart__plot:after{content:\"\";position:absolute;width:54%;height:54%;border-radius:50%;background:#fff}.ami-donut-chart__plot span{position:relative;z-index:1;display:grid;color:var(--pli-muted);font-size:.62rem;text-align:center}.ami-donut-chart__plot strong{color:var(--pli-deep);font-size:1.15rem}.ami-donut-chart figcaption>strong{display:block;margin-bottom:.65rem;color:var(--pli-deep);font-size:.72rem}.ami-donut-chart ul{display:grid;gap:.42rem;margin:0;padding:0;list-style:none}.ami-donut-chart li{display:grid;grid-template-columns:.7rem minmax(0,1fr) auto;gap:.4rem;align-items:center;color:var(--pli-muted);font-size:.64rem}.ami-donut-chart li>span:nth-child(2){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ami-donut-chart li strong{color:var(--pli-deep);font-size:.62rem;font-variant-numeric:tabular-nums}.ami-donut-chart__swatch{width:.65rem;height:.65rem;border-radius:.18rem}@media(max-width:1100px){.ami-analysis-split{grid-template-columns:minmax(0,2fr) minmax(0,3fr)}.ami-page #ami-analysis-participation{grid-template-columns:repeat(6,minmax(0,1fr))}.ami-donut-chart{grid-template-columns:minmax(8rem,10rem) minmax(8rem,1fr)}}@media(max-width:720px){.ami-analysis-split{grid-template-columns:1fr}.ami-page #ami-analysis-participation{grid-template-columns:repeat(2,minmax(0,1fr))}.ami-donut-chart{grid-template-columns:minmax(8rem,11rem) minmax(9rem,1fr)}}\r\n\r\n/* --- Espaco analitico: leitura por par de criterios, por criterio e por julgador --- */\r\n.ami-subsection-hint{margin:.1rem 0 .75rem;color:var(--pli-muted);font-size:.7rem;line-height:1.45}\r\n/* Tabela e grafico ocupam a largura toda, um sobre o outro: com oito colunas\r\n   a tabela nao cabe em meia largura e a coluna de nomes colapsa. */\r\n.ami-analysis-stack{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem}\r\n.ami-analysis-stack>.matriz-table-wrap{margin:0;overflow-x:auto}\r\n.ami-analysis-stack>.ami-analysis-chart{min-width:0}\r\n.ami-stats-table{width:100%;min-width:48rem}\r\n.ami-stats-table th,.ami-stats-table td{text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap}\r\n.ami-stats-table th:first-child,.ami-stats-table .ami-stats-table__name{min-width:13rem;text-align:left;white-space:normal}\r\n.ami-stats-table th:last-child,.ami-stats-table td:last-child{min-width:12rem}\r\n.ami-stats-table .ami-stats-table__name small{color:var(--pli-muted)}\r\n\r\n/* Barras dos indices atribuidos, com realce cruzado com a tabela. */\r\n.ami-pair-bars{display:grid;gap:.45rem;margin:0}\r\n.ami-pair-bars__row{display:grid;grid-template-columns:minmax(9rem,15rem) minmax(0,1fr);gap:.6rem;align-items:center;padding:.15rem .25rem;border-radius:6px}\r\n.ami-pair-bars__row.is-hl{background:#eef4fa;box-shadow:inset 3px 0 0 var(--pli-blue)}\r\n.ami-pair-bars__label{overflow:hidden;color:var(--pli-deep);font-size:.66rem;font-weight:700;text-align:right;text-overflow:ellipsis;white-space:nowrap}\r\n.ami-pair-bars__plot{position:relative;display:grid;gap:.12rem;padding:.15rem 0}\r\n.ami-pair-bars__ref{position:absolute;top:0;bottom:0;width:1px;background:#9fb0bd}\r\n.ami-pair-bars__bar{position:relative;display:flex;align-items:center;justify-content:flex-end;height:.78rem;padding-right:.3rem;border-radius:0 3px 3px 0;color:#fff;font-size:.58rem;cursor:pointer;transition:filter .12s ease}\r\n.ami-pair-bars__bar b{font-variant-numeric:tabular-nums;text-shadow:0 1px 2px rgba(0,0,0,.35)}\r\n.ami-pair-bars__bar.is-curta{justify-content:flex-start;overflow:visible}\r\n.ami-pair-bars__bar.is-curta b{position:absolute;left:calc(100% + .25rem);color:var(--pli-deep);text-shadow:none;white-space:nowrap}\r\n.ami-pair-bars__bar:hover{filter:brightness(1.12)}\r\n.ami-pair-bars figcaption{margin-top:.6rem;color:var(--pli-muted);font-size:.62rem;text-align:center}\r\n.ami-pair-bars__legend{display:flex;flex-wrap:wrap;justify-content:center;gap:.3rem .9rem;margin:0 0 .35rem;padding:0;list-style:none}\r\n.ami-pair-bars__legend li{display:inline-flex;gap:.3rem;align-items:center;font-size:.62rem}\r\n.ami-stats-table tbody tr.is-hl td{background:#eef4fa}\r\n\r\n/* Faixa min-max com a media marcada, para os pesos por criterio. */\r\n.ami-range-chart{display:grid;gap:.55rem;margin:0}\r\n.ami-range-chart__row{display:grid;grid-template-columns:minmax(9rem,17rem) minmax(0,1fr) 4rem;gap:.6rem;align-items:center}\r\n.ami-range-chart__label{overflow:hidden;color:var(--pli-deep);font-size:.66rem;font-weight:700;text-align:right;text-overflow:ellipsis;white-space:nowrap}\r\n.ami-range-chart__track{position:relative;height:.85rem;border-radius:999px;background:#eef2f6;box-shadow:inset 0 0 0 1px #e0e7ec}\r\n.ami-range-chart__span{position:absolute;top:0;bottom:0;border-radius:999px;background:rgba(17,101,147,.28)}\r\n.ami-range-chart__mean{position:absolute;top:-.12rem;bottom:-.12rem;width:2px;background:var(--pli-deep);transform:translateX(-1px)}\r\n.ami-range-chart__row strong{color:var(--pli-deep);font-size:.64rem;font-variant-numeric:tabular-nums;text-align:right}\r\n.ami-range-chart figcaption{margin-top:.35rem;color:var(--pli-muted);font-size:.62rem;text-align:center}\r\n\r\n/* Seletor de julgador do bloco de indices atribuidos. */\r\n.ami-judge-filter{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:0 0 .75rem}\r\n.ami-judge-filter .c-form-label{margin:0;font-size:.68rem}\r\n.ami-judge-filter select{width:auto;min-width:18rem;height:2rem;padding:.2rem .5rem;font-size:.7rem}\r\n.ami-judge-filter__hint{color:var(--pli-muted);font-size:.64rem}\r\n.ami-judge-filter__btn{display:inline-flex;gap:.35rem;align-items:center;padding:.3rem .7rem;border:1px solid #c9d5de;border-radius:999px;background:#fff;color:var(--pli-deep);font:inherit;font-size:.66rem;cursor:pointer}\r\n.ami-judge-filter__btn:hover{border-color:var(--pli-blue);background:#f2f7fb}\r\n.ami-judge-filter__btn.is-active{border-color:var(--pli-deep);background:var(--pli-deep);color:#fff}\r\n.ami-judge-chip{display:inline-block;width:.6rem;height:.6rem;border-radius:50%;box-shadow:0 0 0 1px rgba(255,255,255,.6)}\r\n.ami-stats-table tr.is-discrepante td,.ami-stats-table td.is-discrepante-cell{background:#fdf3e6}\r\n.ami-table-note{display:flex;flex-wrap:wrap;gap:.3rem 1.1rem;margin:.5rem 0 0;color:var(--pli-muted);font-size:.62rem}\r\n.ami-table-note span{display:inline-flex;gap:.3rem;align-items:center}\r\n\r\n/* Celulas dos indices: cor = afastamento da media geometrica do par. */\r\n.ami-stats-table__valor{font-variant-numeric:tabular-nums}\r\n.ami-stats-table__valor.is-forte{color:#fff;font-weight:700}\r\n.ami-table-note__escala{display:inline-flex;gap:.25rem;align-items:center}\r\n.ami-table-note__escala i{width:.85rem;height:.6rem;border-radius:2px;background:rgba(17,101,147,.05)}\r\n.ami-table-note__escala i:nth-child(2){background:rgba(17,101,147,.3)}\r\n.ami-table-note__escala i:nth-child(3){background:rgba(17,101,147,.55)}\r\n.ami-table-note__escala i:nth-child(4){background:rgba(17,101,147,.8)}\r\n\r\n/* Elo entre as secoes do fio analitico. */\r\n.ami-fio-elo{position:relative;margin:.15rem 0 .9rem;padding:.5rem 1rem .5rem 2.4rem;border-radius:8px;background:rgba(17,101,147,.06);color:var(--pli-deep);font-size:.7rem}\r\n.ami-fio-elo:before{content:\"\";position:absolute;left:1rem;top:50%;width:.5rem;height:.5rem;border-right:2px solid var(--pli-blue);border-bottom:2px solid var(--pli-blue);transform:translateY(-50%) rotate(45deg)}\r\n.ami-matrix td.is-diagonal{background:#eef4fa;font-weight:700}\r\n\r\n/* Convidado sem resposta: linha discreta, campos vazios. */\r\n.ami-stats-table tr.is-sem-resposta td{color:var(--pli-muted)}\r\n.ami-cell-vazio{background:repeating-linear-gradient(135deg,transparent,transparent 5px,rgba(0,0,0,.03) 5px,rgba(0,0,0,.03) 10px)}\r\n\r\n/* Larguras por tabela: cada uma tem o seu conjunto de colunas. */\r\n.ami-table--julgadores{min-width:56rem}\r\n.ami-table--julgadores th:nth-child(1),.ami-table--julgadores td:nth-child(1){width:15rem;min-width:15rem}\r\n.ami-table--julgadores th:nth-child(2),.ami-table--julgadores td:nth-child(2){width:16rem;min-width:16rem}\r\n.ami-table--julgadores th:nth-child(3),.ami-table--julgadores td:nth-child(3){width:11rem;min-width:11rem}\r\n.ami-table--julgadores th:nth-child(n+4),.ami-table--julgadores td:nth-child(n+4){width:7rem;min-width:7rem}\r\n\r\n.ami-table--respostas{min-width:56rem}\r\n.ami-table--respostas th:nth-child(1),.ami-table--respostas td:nth-child(1){width:5.5rem;min-width:5.5rem}\r\n.ami-table--respostas th:nth-child(2),.ami-table--respostas td:nth-child(2){width:15rem;min-width:15rem}\r\n.ami-table--respostas th:nth-child(3),.ami-table--respostas td:nth-child(3){width:16rem;min-width:16rem}\r\n.ami-table--respostas th:nth-child(n+4),.ami-table--respostas td:nth-child(n+4){width:7rem;min-width:7rem}\r\n\r\n/* Tabela dos indices: largura repartida entre as colunas, sem rolagem lateral\r\n   por causa de um julgador a mais. */\r\n.ami-table--indices{table-layout:fixed;width:100%;min-width:0}\r\n.ami-table--indices th,.ami-table--indices td{min-width:0;padding-left:.3rem;padding-right:.3rem;overflow:hidden;text-overflow:ellipsis}\r\n.ami-table--indices th:first-child,.ami-table--indices td:first-child{width:26%;min-width:0;white-space:normal}\r\n.ami-table--indices th:not(:first-child){white-space:normal;word-break:normal;overflow-wrap:normal;hyphens:none;font-size:.6rem}\r\n\r\n.ami-matrix{min-width:34rem}\r\n.ami-matrix th:first-child,.ami-matrix td:first-child,.ami-matrix td.ami-stats-table__name{width:14rem;min-width:14rem;text-align:left}\r\n.ami-matrix th:not(:first-child){white-space:normal;min-width:7rem}\r\n\r\n.ami-table--pesos{min-width:20rem}\r\n.ami-table--pesos th:first-child,.ami-table--pesos td:first-child{width:auto;min-width:12rem}\r\n.ami-table--pesos th:last-child,.ami-table--pesos td:last-child{width:7rem;min-width:7rem;text-align:center}\r\n\r\n/* Tabela e grafico lado a lado dentro dos blocos analiticos. */\r\n.ami-page .ami-analysis-split{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:1.1rem;align-items:start}\r\n.ami-page .ami-analysis-split>.matriz-table-wrap{margin:0;min-width:0;overflow-x:auto}\r\n.ami-page .ami-analysis-split>.ami-analysis-chart{min-width:0}\r\n@media(max-width:1200px){.ami-page .ami-analysis-split{grid-template-columns:minmax(0,1fr)}}\r\n\r\n/* Cards das metricas: a situacao salta aos olhos pela cor de fundo, pela faixa\r\n   superior e pelo selo; a explicacao vive fora deles. */\r\n.ami-metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:.75rem}\r\n.ami-metric-card{position:relative;overflow:hidden;padding:.85rem .9rem .8rem;border:1.5px solid #dbe3ea;border-radius:10px;background:#fff}\r\n.ami-metric-card:before{content:\"\";position:absolute;inset:0 0 auto;height:.4rem;background:#c3ced7}\r\n.ami-metric-card.is-ok{border-color:#1f8a4c;background:rgba(31,138,76,.09)}\r\n.ami-metric-card.is-ok:before{background:#1f8a4c}\r\n.ami-metric-card.is-atencao{border-color:#c58f00;background:rgba(197,143,0,.11)}\r\n.ami-metric-card.is-atencao:before{background:#c58f00}\r\n.ami-metric-card.is-nok{border-color:#b3261e;background:rgba(179,38,30,.09)}\r\n.ami-metric-card.is-nok:before{background:#b3261e}\r\n.ami-metric-card.is-neutro{background:#f4f7fa}\r\n.ami-metric-card__top{display:flex;flex-wrap:wrap;gap:.35rem;align-items:center;justify-content:space-between;margin-top:.3rem}\r\n.ami-metric-card__label{color:var(--pli-deep);font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.02em}\r\n.ami-metric-card__selo{display:inline-flex;gap:.3rem;align-items:center;padding:.18rem .5rem;border-radius:999px;background:#5b6b78;color:#fff;font-size:.58rem;font-weight:700}\r\n.ami-metric-card.is-ok .ami-metric-card__selo{background:#1f8a4c}\r\n.ami-metric-card.is-atencao .ami-metric-card__selo{background:#c58f00}\r\n.ami-metric-card.is-nok .ami-metric-card__selo{background:#b3261e}\r\n.ami-metric-card__value{margin:.25rem 0 .1rem;color:var(--pli-deep);font-size:1.9rem;font-weight:800;font-variant-numeric:tabular-nums;line-height:1.1}\r\n.ami-metric-card.is-ok .ami-metric-card__value{color:#166b3a}\r\n.ami-metric-card.is-atencao .ami-metric-card__value{color:#8a6500}\r\n.ami-metric-card.is-nok .ami-metric-card__value{color:#8e1e18}\r\n.ami-metric-card__gauge{height:.45rem;margin:.35rem 0 .25rem;border-radius:999px;background:rgba(0,0,0,.08);overflow:hidden}\r\n.ami-metric-card__gauge span{display:block;height:100%;border-radius:999px;background:#1f8a4c}\r\n.ami-metric-card.is-nok .ami-metric-card__gauge span{background:#b3261e}\r\n.ami-metric-card__note{color:var(--pli-muted);font-size:.62rem}\r\n\r\n/* Explicacao das metricas, fora dos cards. */\r\n.ami-metric-help{margin-top:1rem;padding:.85rem 1rem;border:1px solid #e2e8ee;border-radius:10px;background:#f7f9fb;text-align:left}\r\n.ami-metric-help h4{margin:0 0 .55rem;color:var(--pli-deep);font-size:.72rem;text-transform:uppercase;letter-spacing:.03em}\r\n.ami-metric-help dl{display:grid;grid-template-columns:minmax(11rem,auto) minmax(0,1fr);gap:.3rem .9rem;margin:0}\r\n.ami-metric-help dt{color:var(--pli-deep);font-size:.66rem;font-weight:700;text-align:left}\r\n.ami-metric-help dd{margin:0;color:var(--pli-muted);font-size:.66rem;line-height:1.45;text-align:left}\r\n.ami-metric-help__fecho{margin:.7rem 0 0;padding:.5rem .7rem;border-radius:8px;font-size:.68rem;font-weight:600;text-align:left}\r\n.ami-metric-help__fecho.is-ok{background:rgba(31,138,76,.12);color:#166b3a}\r\n.ami-metric-help__fecho.is-nok{background:rgba(179,38,30,.1);color:#8e1e18}\r\n@media(max-width:820px){.ami-metric-help dl{grid-template-columns:1fr}}\r\n\r\n/* Modal de acompanhamento da consolidacao. */\r\n.ami-process-modal__card{width:min(560px,94vw)}\r\n.ami-process-bar{height:.45rem;margin:.2rem 0 .9rem;border-radius:999px;background:#e5ebf0;overflow:hidden}\r\n.ami-process-bar span{display:block;width:0;height:100%;border-radius:999px;background:var(--pli-blue);transition:width .25s ease}\r\n.ami-process-steps{display:grid;gap:.55rem;margin:0;padding:0;list-style:none;counter-reset:etapa}\r\n.ami-process-step{display:flex;gap:.6rem;align-items:flex-start;padding:.55rem .7rem;border:1px solid #e2e8ee;border-radius:8px;background:#fff}\r\n.ami-process-step i{margin-top:.15rem;color:#c3ced7}\r\n.ami-process-step strong{display:block;color:var(--pli-deep);font-size:.72rem}\r\n.ami-process-step span{display:block;color:var(--pli-muted);font-size:.66rem}\r\n.ami-process-step.is-andamento{border-color:var(--pli-blue);background:#f2f8fc}\r\n.ami-process-step.is-andamento i{color:var(--pli-blue)}\r\n.ami-process-step.is-ok i{color:#1f8a4c}\r\n.ami-process-step.is-erro{border-color:rgba(179,38,30,.5);background:rgba(179,38,30,.06)}\r\n.ami-process-step.is-erro i{color:#b3261e}\r\n\r\n/* Modal de veredito, em semaforo. */\r\n.ami-result-modal__card{width:min(560px,94vw)}\r\n.ami-semaforo{display:inline-flex;gap:.45rem;padding:.5rem .6rem;border-radius:999px;background:#22303c}\r\n.ami-semaforo__luz{width:1.1rem;height:1.1rem;border-radius:50%;background:#3d4c59}\r\n.ami-semaforo.is-verde .is-verde{background:#25c368;box-shadow:0 0 12px rgba(37,195,104,.8)}\r\n.ami-semaforo.is-amarela .is-amarela{background:#f2c230;box-shadow:0 0 12px rgba(242,194,48,.8)}\r\n.ami-semaforo.is-vermelha .is-vermelha{background:#e5484d;box-shadow:0 0 12px rgba(229,72,77,.8)}\r\n.ami-result-title{margin:.7rem 0 .2rem;color:var(--pli-deep);font-size:.95rem;font-weight:700}\r\n.ami-result-text{margin:0 0 .8rem;color:var(--pli-muted);font-size:.72rem;line-height:1.5}\r\n\r\n/* Secao 2: tabelas compactas, uma linha por celula sempre que couber. */\r\n.ami-page #ami-analysis-workspace .ami-stats-table{font-size:.63rem}\r\n.ami-page #ami-analysis-workspace .ami-stats-table th{font-size:.6rem;padding:.42rem .4rem;letter-spacing:0}\r\n.ami-page #ami-analysis-workspace .ami-stats-table td{height:auto;padding:.32rem .45rem;line-height:1.25}\r\n.ami-page #ami-analysis-workspace .ami-stats-table td,\r\n.ami-page #ami-analysis-workspace .ami-stats-table .ami-stats-table__name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n/* o cabecalho do julgador e a sua identificacao: quebra em duas linhas em vez\r\n   de virar reticencias iguais para todo mundo */\r\n.ami-page #ami-analysis-workspace .ami-table--indices th:not(:first-child){white-space:normal;overflow:visible;font-size:.56rem;line-height:1.2}\r\n.ami-page #ami-analysis-workspace .ami-matrix th:not(:first-child){white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\r\n\r\n/* Cabecalho das subsecoes: fundo solido e texto legivel. */\r\n.ami-page #ami-analysis-workspace .ahp-subsection-title{background:var(--pli-deep);border-bottom:0;color:#fff;font-size:.72rem}\r\n.ami-page #ami-analysis-workspace .ahp-subsection-title>span:last-child{color:#fff}\r\n.ami-page #ami-analysis-workspace .ahp-subsection-num{background:var(--pli-green);color:var(--pli-deep);font-size:.68rem}\r\n\r\n/* ==== Escala tipografica da secao 2 ====================================== */\r\n#ami-analysis-workspace,\r\n.ami-process-modal,\r\n.ami-result-modal {\r\n  /* titulo de subsecao / rotulo de card */\r\n  --ami2-titulo: .72rem;\r\n  /* texto corrido: dicas, elos, explicacoes, listas de definicao */\r\n  --ami2-texto: .68rem;\r\n  /* corpo das tabelas, campos e rotulos de grafico */\r\n  --ami2-dado: .64rem;\r\n  /* cabecalho de tabela, notas de rodape, legendas, selos */\r\n  --ami2-nota: .6rem;\r\n  /* numero grande dos cards de metrica */\r\n  --ami2-numero: 1.7rem;\r\n}\r\n\r\n/* --- titulos ------------------------------------------------------------- */\r\n.ami-page #ami-analysis-workspace .ahp-subsection-title,\r\n.ami-page .ami-process-modal .ami-data-modal__head h2,\r\n.ami-page .ami-result-modal .ami-data-modal__head h2 { font-size: var(--ami2-titulo) }\r\n.ami-page #ami-analysis-workspace .ahp-subsection-num { font-size: var(--ami2-nota) }\r\n.ami-page .ami-result-title,\r\n.ami-page .ami-metric-help h4 { font-size: var(--ami2-titulo) }\r\n\r\n/* --- texto corrido ------------------------------------------------------- */\r\n.ami-page #ami-analysis-workspace .ami-subsection-hint,\r\n.ami-page #ami-analysis-workspace .step-intro,\r\n.ami-page .ami-fio-elo,\r\n.ami-page .ami-metric-help dt,\r\n.ami-page .ami-metric-help dd,\r\n.ami-page .ami-metric-help__fecho,\r\n.ami-page .ami-result-text,\r\n.ami-page .ami-modal-description,\r\n.ami-page .ami-process-step strong,\r\n.ami-page #ami-analysis-workspace .ami-feedback,\r\n.ami-page #ami-analysis-workspace label { font-size: var(--ami2-texto) }\r\n\r\n/* --- dados --------------------------------------------------------------- */\r\n.ami-page #ami-analysis-workspace .ami-stats-table,\r\n.ami-page #ami-analysis-workspace .ami-stats-table td,\r\n.ami-page #ami-analysis-workspace .c-form-control,\r\n.ami-page #ami-analysis-workspace .c-form-label,\r\n.ami-page .ami-judge-filter select,\r\n.ami-page .ami-pair-bars__label,\r\n.ami-page .ami-pair-bars__row strong,\r\n.ami-page .ami-range-chart__label,\r\n.ami-page .ami-range-chart__row strong,\r\n.ami-page .ami-result-modal .ami-modal-fields dt,\r\n.ami-page .ami-result-modal .ami-modal-fields dd { font-size: var(--ami2-dado) }\r\n\r\n/* --- notas, cabecalhos de tabela, legendas e selos ----------------------- */\r\n.ami-page #ami-analysis-workspace .ami-stats-table th,\r\n.ami-page #ami-analysis-workspace .ami-table--indices th:not(:first-child),\r\n.ami-page .ami-judge-filter__hint,\r\n.ami-page .ami-table-note,\r\n.ami-page .ami-pair-bars__bar b,\r\n.ami-page .ami-pair-bars figcaption,\r\n.ami-page .ami-pair-bars__legend li,\r\n.ami-page .ami-range-chart figcaption,\r\n.ami-page .ami-metric-card__label,\r\n.ami-page .ami-metric-card__selo,\r\n.ami-page .ami-metric-card__note,\r\n.ami-page .ami-process-step span { font-size: var(--ami2-nota) }\r\n\r\n/* --- numeros em destaque ------------------------------------------------- */\r\n.ami-page .ami-metric-card__value { font-size: var(--ami2-numero) }\r\n.ami-page #ami-analysis-workspace .ahp-metric-card__label { font-size: var(--ami2-nota) }\r\n.ami-page #ami-analysis-workspace .ahp-metric-card__value { font-size: 1.25rem }\r\n\r\n/* Aviso da analise homologada: dali seguem as tres fases da hierarquizacao. */\r\n.ami-homologada{margin-top:.9rem;padding:.85rem 1rem;border:1px solid rgba(31,138,76,.45);border-left:5px solid #1f8a4c;border-radius:10px;background:rgba(31,138,76,.08);text-align:left}\r\n.ami-homologada__titulo{margin:0 0 .3rem;color:#166b3a;font-size:var(--ami2-texto,.68rem)}\r\n.ami-homologada__titulo i{margin-right:.2rem}\r\n.ami-homologada__texto{margin:0 0 .6rem;color:var(--pli-deep);font-size:var(--ami2-texto,.68rem);line-height:1.45}\r\n.ami-homologada__fases{display:grid;gap:.4rem;margin:0;padding:0;list-style:none}\r\n.ami-homologada__fases a{display:flex;gap:.6rem;align-items:center;padding:.5rem .7rem;border:1px solid #d5e3da;border-radius:8px;background:#fff;color:var(--pli-deep);text-decoration:none}\r\n.ami-homologada__fases a:hover{border-color:#1f8a4c;background:#f3faf6}\r\n.ami-homologada__fases a>span:nth-child(2){display:grid;min-width:0}\r\n.ami-homologada__fases strong{font-size:var(--ami2-dado,.64rem)}\r\n.ami-homologada__fases small{color:var(--pli-muted);font-size:var(--ami2-nota,.6rem)}\r\n.ami-homologada__fases a>i{margin-left:auto;color:#1f8a4c}\r\n.ami-homologada__num{display:grid;width:1.4rem;height:1.4rem;flex:0 0 1.4rem;place-items:center;border-radius:50%;background:#1f8a4c;color:#fff;font-size:var(--ami2-nota,.6rem);font-weight:800}\r\n",
  "http://127.0.0.1:8083/assets/css/ahp-collab-rounds.css": ".collab-round-row{cursor:pointer}\r\n.collab-round-row.is-selected{background:#eaf4fb!important;box-shadow:inset 4px 0 #1976b9}\r\n.collab-round-context{margin-left:auto;padding:.25rem .6rem;border-radius:999px;background:#e8f2fa;color:#145d8f;font-size:.78rem;font-weight:700;text-transform:none}\r\n",
  "http://127.0.0.1:8083/assets/css/analise-multicriterio-tabela.css?v=20260831-larguras-colunas": ".ami-table-shell {\r\n  overflow: auto;\r\n  max-height: 36rem;\r\n  border: 1px solid #d8e0e5;\r\n  border-radius: 10px;\r\n}\r\n\r\n.ami-table-heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n}\r\n\r\n.ami-table-actions {\r\n  margin-top: .85rem;\r\n}\r\n\r\n.ami-table-actions .is-disabled {\r\n  opacity: .45;\r\n  pointer-events: none;\r\n}\r\n\r\n.ami-table-actions .admin-icon-btn-primary.is-disabled {\r\n  color: var(--pli-deep);\r\n  background: #fff;\r\n  border-color: #c5d0da;\r\n}\r\n\r\n.ami-inline-input {\r\n  width: 100%;\r\n  min-width: 10rem;\r\n  height: 2rem;\r\n  padding: .3rem .5rem;\r\n  border: 1px solid var(--pli-blue);\r\n  border-radius: 4px;\r\n  background: #fff;\r\n  color: var(--pli-text);\r\n  font: inherit;\r\n}\r\n\r\n.ami-inline-input:focus {\r\n  outline: 2px solid rgba(17, 101, 147, .18);\r\n  outline-offset: 1px;\r\n}\r\n\r\n.ami-table-feedback {\r\n  min-height: 1.25rem;\r\n  margin: .45rem 1rem 0;\r\n  color: #24633d;\r\n  font-size: .75rem;\r\n}\r\n\r\n.ami-table-feedback.is-error {\r\n  color: #922b21;\r\n}\r\n\r\n.ami-table--database {\r\n  min-width: 2700px;\r\n  font-size: .74rem;\r\n}\r\n\r\n.ami-table--database .ami-cell-id {\r\n  width: 17rem;\r\n  max-width: 17rem;\r\n  font-family: Consolas, \"Courier New\", monospace;\r\n}\r\n\r\n.ami-table--database .ami-cell-token {\r\n  width: 20rem;\r\n  max-width: 20rem;\r\n  font-family: Consolas, \"Courier New\", monospace;\r\n}\r\n\r\n.ami-table--database thead {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 3;\r\n}\r\n\r\n.ami-table--database th,\r\n.ami-table--database td {\r\n  text-align: center;\r\n  vertical-align: middle;\r\n  line-height: 1.1;\r\n}\r\n\r\n.ami-table--database th {\r\n  padding: .5rem .6rem;\r\n  background: var(--pli-deep);\r\n  color: #fff;\r\n  font-size: .68rem;\r\n}\r\n\r\n.ami-table--database td {\r\n  height: 1.7rem;\r\n  max-width: 220px;\r\n  padding: .18rem .55rem;\r\n  overflow: hidden;\r\n  color: inherit;\r\n  font-size: .64rem;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.ami-table--database .col-select {\r\n  width: 2.75rem;\r\n  min-width: 2.75rem;\r\n  max-width: 2.75rem;\r\n}\r\n\r\n.ami-table--database .col-select input[type=\"checkbox\"] {\r\n  width: 1rem;\r\n  height: 1rem;\r\n  accent-color: var(--pli-blue);\r\n  cursor: pointer;\r\n}\r\n\r\n.ami-table--database tbody tr.is-selected td {\r\n  background: #eef4fa;\r\n}\r\n\r\n.ami-table--database tbody tr.is-selected td:first-child {\r\n  box-shadow: inset 3px 0 0 var(--pli-blue), 2px 0 6px rgba(0, 59, 90, .08);\r\n}\r\n\r\n.ami-cell-link {\r\n  max-width: 100%;\r\n  overflow: hidden;\r\n  padding: 0;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--pli-blue);\r\n  font: inherit;\r\n  text-decoration: underline;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n}\r\n\r\n.ami-row-actions {\r\n  display: flex;\r\n  flex-direction: row;\r\n  justify-content: center;\r\n  gap: .4rem;\r\n  min-width: 5rem;\r\n}\r\n\r\n.ami-field-source {\r\n  margin: -.35rem 0 .75rem;\r\n  color: var(--pli-muted);\r\n  font-size: .78rem;\r\n}\r\n\r\n.ami-field-source a {\r\n  color: var(--pli-blue);\r\n  font-weight: 700;\r\n}\r\n\r\n.ami-pagination {\r\n  margin: .75rem 0 0;\r\n}\r\n\r\n.ami-page .ami-table--database,\r\n.ami-page .ami-table--database th,\r\n.ami-page .ami-table--database td,\r\n.ami-page .ami-table--database button,\r\n.ami-page .ami-pagination {\r\n  font-size: var(--ami-font-child, .70rem);\r\n}\r\n\r\n.ami-page .ami-table-heading {\r\n  margin-bottom: var(--ami-space-sm, .75rem);\r\n}\r\n\r\n/*\r\n  Central de respostas: dez colunas apenas, entao a tabela ocupa a largura do\r\n  painel em vez do min-width das 17 colunas do espaco analitico. As larguras\r\n  sao fixas para que as cinco metricas (mesmo denominador