  "http://127.0.0.1:8083/assets/js/ahp-process-monitor.js": "/* Monitor transversal do fluxo AHP: progresso, erros e status das ações. */\r\n(function (global) {\r\n  \"use strict\";\r\n  // Páginas com `feedback-proprio` relatam o processo real (confirmação, log do\r\n  // servidor e desfecho). O monitor não substitui esse acompanhamento.\r\n  function ativo() {\r\n    if (document.body.classList.contains(\"feedback-proprio\")) return false;\r\n    return document.body.classList.contains(\"ahp-module-page\") || document.body.classList.contains(\"ahp-colaborativa-page\");\r\n  }\r\n  function mensagem(el) { return (el && (el.getAttribute(\"aria-label\") || el.textContent || \"\")).replace(/\\s+/g, \" \").trim(); }\r\n  var TAREFA = \"Aguardando a resposta do serviço\";\r\n  function iniciar(acao) {\r\n    if (!global.ProcessFeedback || !ativo()) return null;\r\n    var proc = global.ProcessFeedback.iniciarCadastro(acao || \"Executar ação AHP\", [TAREFA]);\r\n    proc.tarefaAtual(TAREFA);\r\n    return { proc: proc, acao: acao || \"Executar ação AHP\" };\r\n  }\r\n  function concluir(ref, tipo, texto) {\r\n    if (!ref) return;\r\n    if (tipo === \"error\") { ref.proc.erro({ message: texto || \"O serviço recusou a operação.\" }); return; }\r\n    ref.proc.concluirTarefa(TAREFA, \"Resposta recebida\");\r\n    ref.proc.sucesso({ message: texto || \"Operação concluída.\", _status: tipo === \"warning\" ? \"partial\" : undefined });\r\n  }\r\n  // O chamador inicia/conclui com a resposta real. Cliques e timers não\r\n  // comprovam validação, execução ou sucesso no servidor.\r\n  global.addEventListener(\"error\", function (event) {\r\n    if (!ativo() || !global.Notify) return;\r\n    global.Notify.error(\"Falha no processo AHP\", event.message || \"Erro inesperado no navegador.\");\r\n  });\r\n  global.addEventListener(\"unhandledrejection\", function (event) {\r\n    if (!ativo() || !global.Notify) return;\r\n    var reason = event.reason && event.reason.message ? event.reason.message : String(event.reason || \"Erro inesperado.\");\r\n    global.Notify.error(\"Falha na operação AHP\", reason);\r\n  });\r\n  global.SLTAhpProcess = { iniciar: iniciar, concluir: concluir };\r\n})(window);\r\n",
  "http://127.0.0.1:8083/assets/js/table-smart-widths.js?v=20261027-secao7-direta": "/* Content-aware table widths. Keep selectors fixed and never truncate headings. */\n(function () {\n  'use strict';\n  const canvas = document.createElement('canvas'), context = canvas.getContext('2d');\n  const selector = 'main table.admin-table, main table.ami-matrix';\n  const set = (node, property, value) => node.style.setProperty(property, value, 'important');\n  function measure(text, cell) {\n    const css = getComputedStyle(cell);\n    context.font = `${css.fontWeight} ${css.fontSize} ${css.fontFamily}`;\n    return context.measureText(css.textTransform === 'uppercase' ? text.toLocaleUpperCase('pt-BR') : text).width;\n  }\n  function fit(table) {\n    if (!table.getBoundingClientRect().width || !table.tHead?.rows.length) return;\n    const headers = window.SLTTable?.headers ? SLTTable.headers(table) : [...table.tHead.rows[0].cells];\n    if (headers.some(h => h.colSpan !== 1)) return;\n    const rows = [...table.tBodies].flatMap(body => [...body.rows]).filter(row => row.cells.length === headers.length && [...row.cells].every(c => c.colSpan === 1));\n    const specifications = headers.map((header, index) => {\n      const selected = index === 0 && header.querySelector('input[type=checkbox]');\n      if (selected) return {preferred:44, compact:44};\n      let label = header.querySelector(':scope > .smart-column-title');\n      if (!label) {\n        label = document.createElement('span'); label.className = 'smart-column-title';\n        const nodes = [...header.childNodes].filter(n => n.nodeType === 3 || (n.nodeType === 1 && !n.matches('input, .table-sort-indicator, .sort-indicator')));\n        label.append(...nodes); header.prepend(label);\n      }\n      const title = label.textContent.replace(/\\s+/g,' ').trim(), full = measure(title, header);\n      let titleWidth = full;\n      if (title.length > 10) {\n        const words = title.split(/\\s+/);\n        titleWidth = words.length > 1 ? Math.min(...words.slice(1).map((_, i) => Math.max(measure(words.slice(0, i+1).join(' '), header), measure(words.slice(i+1).join(' '), header)))) : Math.min(full, 180);\n      }\n      const content = rows.reduce((max, row) => Math.max(max, measure(row.cells[index].textContent.trim(), row.cells[index])), 0);\n      const dataWidth = Math.min(320, content + 24);\n      return {preferred:Math.ceil(Math.max(76,full+32,dataWidth)), compact:Math.ceil(Math.max(76,titleWidth+32,dataWidth)), title, full, label};\n    });\n    const available = table.parentElement.clientWidth;\n    const fits = specifications.reduce((sum,s)=>sum+s.preferred,0)<=available;\n    const widths = specifications.map(s=>fits?s.preferred:s.compact);\n    const initialTotal = widths.reduce((a,b) => a+b, 0), flexible = widths.filter((_,i) => !(i === 0 && headers[i].querySelector('input[type=checkbox]'))).length;\n    const spare = Math.max(0, available-initialTotal) / Math.max(1, flexible);\n    widths.forEach((width,i)=>{\n      const spec=specifications[i];\n      if(!spec.label)return; // Selectors remain exactly 44px.\n      widths[i]=width+spare;\n      const missing=spec.full+32-widths[i];\n      const tolerance=Math.max(measure(spec.title.slice(-3),headers[i]),spec.full/Math.max(1,spec.title.length)*3);\n      if(missing>0 && missing<=tolerance)widths[i]=Math.ceil(spec.full+32);\n    });\n    const total=widths.reduce((a,b)=>a+b,0), extra=0;\n    headers.forEach((header, i) => {\n      const selected = i === 0 && header.querySelector('input[type=checkbox]');\n      const width = widths[i] + (selected ? 0 : extra);\n      if (!selected) {\n        const {label,title,full}=specifications[i], room=width-32;\n        const lines=[];let line='';\n        if(title.length>10 && full>room){\n          const words=title.split(/\\s+/);\n          let split=1,best=Infinity;\n          for(let k=1;k<words.length;k++){const a=measure(words.slice(0,k).join(' '),header),b=measure(words.slice(k).join(' '),header);if(Math.max(a,b)<best){best=Math.max(a,b);split=k;}}\n          if(words.length>1 && best<=room){lines.push(words.slice(0,split).join(' '),words.slice(split).join(' '));}\n          else {for(const char of title){if(line && measure(line+char,header)>room){lines.push(line.trim());line='';}line+=char;}if(line)lines.push(line.trim());}\n        } else lines.push(title);\n        label.replaceChildren(...lines.map((text,index)=>{const paragraph=document.createElement('span');paragraph.style.display='block';paragraph.textContent=text+(index<lines.length-1?' ':'');return paragraph;}));\n        label.style.display='inline-block';label.style.maxWidth='100%';label.style.textAlign=lines.length>1?'justify':'center';\n        set(label,'white-space','normal');set(label,'overflow-wrap','anywhere');\n      }\n      for (const cell of [header, ...rows.map(row=>row.cells[i])]) {\n        set(cell,'width', width+'px'); set(cell,'min-width','0'); set(cell,'max-width','none');\n        set(cell,'box-sizing','border-box');\n      }\n      set(header,'white-space','normal'); set(header,'overflow','visible'); set(header,'text-overflow','clip');\n      set(header,'overflow-wrap','anywhere'); set(header,'height','32px'); set(header,'min-height','32px');\n      set(header,'padding-top','8px'); set(header,'padding-bottom','8px');\n    });\n    if(table.dataset.groupedHeaders==='true'){\n      let columns=table.querySelector('colgroup[data-smart-columns]');\n      if(!columns){columns=document.createElement('colgroup');columns.dataset.smartColumns='true';table.prepend(columns);}\n      columns.replaceChildren(...widths.map((width,i)=>{const col=document.createElement('col');col.style.width=(width+(i===0&&headers[i].querySelector('input')?0:extra))+'px';return col;}));\n      table.querySelectorAll('thead th[colspan]').forEach(h=>{set(h,'white-space','normal');set(h,'overflow','visible');set(h,'text-overflow','clip');});\n    }\n    set(table,'table-layout','fixed'); set(table,'width',Math.max(total,available)+'px'); set(table,'min-width','0'); set(table,'max-width','none');\n    table.dataset.smartWidths = 'true';\n    table.parentElement.style.overflowX = 'auto';\n  }\n  let scheduled = false;\n  const observer = new MutationObserver(schedule);\n  function schedule() {\n    if (scheduled) return; scheduled = true;\n    requestAnimationFrame(() => {\n      scheduled = false; observer.disconnect();\n      document.querySelectorAll(selector).forEach(fit);\n      document.querySelectorAll('[data-equal-table-height]').forEach(group=>{\n        const tables=[...group.querySelectorAll('table')];\n        tables.forEach(table=>set(table,'height','auto'));\n        if(tables.length<2 || !tables[0].getBoundingClientRect().width)return;\n        // Keep stacked tables natural on mobile; synchronize side-by-side tables.\n        if(Math.abs(tables[0].getBoundingClientRect().left-tables[1].getBoundingClientRect().left)<1)return;\n        const height=Math.max(...tables.map(table=>table.getBoundingClientRect().height));\n        tables.forEach(table=>set(table,'height',height+'px'));\n      });\n      observer.observe(document.querySelector('main') || document.body, {childList:true, subtree:true, characterData:true, attributes:true, attributeFilter:['class','hidden']});\n    });\n  }\n  document.addEventListener('DOMContentLoaded', schedule);\n  window.addEventListener('resize', schedule);\n  document.fonts.ready.then(schedule);\n  window.SLTTableFit = schedule;\n})();\n",
  "http://127.0.0.1:8083/assets/js/template-base.js": "(function (global) {\r\n  \"use strict\";\r\n\r\n  function caminhoAtivo(link) {\r\n    const href = link.getAttribute(\"href\");\r\n    if (!href || !href.startsWith(\"/\")) return false;\r\n    const atual = global.location.pathname;\r\n    return atual === href || (href !== \"/\" && atual.startsWith(href));\r\n  }\r\n\r\n  function marcarNavegacaoAtual() {\r\n    document.querySelectorAll(\".app-nav a[href]\").forEach((link) => {\r\n      // A barra de módulo já vem marcada do servidor, que também compara a\r\n      // query string (?menu=, ?modo=); pelo prefixo do caminho, \"Início do\r\n      // bloco\" e a central do módulo ficariam ativos em todas as páginas.\r\n      if (link.closest(\".app-nav\")?.querySelector(\".app-nav-bloco\")) return;\r\n      if (!caminhoAtivo(link)) return;\r\n      link.classList.add(\"active\");\r\n      link.setAttribute(\"aria-current\", \"page\");\r\n    });\r\n  }\r\n\r\n  // Menus suspensos da navbar de módulo: o hover cobre o mouse; o clique cobre\r\n  // toque e teclado. Um menu aberto fecha ao abrir outro, clicar fora ou Esc.\r\n  function ligarMenusSuspensos() {\r\n    const fecharTodos = () => document.querySelectorAll(\".app-nav-grupo-modulo.aberto\").forEach((grupo) => {\r\n      grupo.classList.remove(\"aberto\");\r\n      const botao = grupo.querySelector(\".app-nav-grupo-botao\");\r\n      botao?.setAttribute(\"aria-expanded\", \"false\");\r\n      botao?.blur();\r\n    });\r\n    document.querySelectorAll(\".app-nav-grupo-botao\").forEach((botao) => {\r\n      botao.addEventListener(\"click\", (evento) => {\r\n        evento.stopPropagation();\r\n        const grupo = botao.closest(\".app-nav-grupo-modulo\");\r\n        const abrir = !grupo.classList.contains(\"aberto\");\r\n        fecharTodos();\r\n        if (!abrir) return;\r\n        grupo.classList.add(\"aberto\");\r\n        botao.setAttribute(\"aria-expanded\", \"true\");\r\n      });\r\n    });\r\n    document.addEventListener(\"click\", fecharTodos);\r\n    document.addEventListener(\"keydown\", (evento) => { if (evento.key === \"Escape\") fecharTodos(); });\r\n  }\r\n\r\n  async function atualizarAcessoRestrito() {\r\n    const links = document.querySelectorAll(\"[data-link-area-restrita]\");\r\n    if (!links.length) return;\r\n    try {\r\n      const resposta = await fetch(\"/api/auth/session\", { credentials: \"include\" });\r\n      if (!resposta.ok) return;\r\n      const sessao = await resposta.json();\r\n      if (sessao?.authenticated !== true) return;\r\n      links.forEach((link) => {\r\n        link.href = \"/restrict/\";\r\n        link.textContent = \"Acessar área restrita\";\r\n      });\r\n    } catch (_erro) {\r\n      // A navegação pública continua funcional quando a sessão não está disponível.\r\n    }\r\n  }\r\n\r\n  function exigirAutenticacaoQuandoConfigurado() {\r\n    if (document.body.dataset.requerAutenticacao !== \"true\") return;\r\n    global.SLTAdminAuth?.requireAuth?.();\r\n  }\r\n\r\n  function iniciar() {\r\n    marcarNavegacaoAtual();\r\n    ligarMenusSuspensos();\r\n    atualizarAcessoRestrito();\r\n    exigirAutenticacaoQuandoConfigurado();\r\n  }\r\n\r\n  global.SLTTemplateBase = { iniciar };\r\n  if (document.readyState === \"loading\") {\r\n    document.addEventListener(\"DOMContentLoaded\", iniciar);\r\n  } else {\r\n    iniciar();\r\n  }\r\n})(window);\r\n",
