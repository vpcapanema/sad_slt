  "http://127.0.0.1:8083/restrict/hierarquizacao/processos.css?v=20261015-fluxo-atual": ".ahp-module-page {\r\n  --process-space-1: 0.375rem;\r\n  --process-space-2: 0.625rem;\r\n  --process-space-3: 0.875rem;\r\n  --process-space-4: 1.25rem;\r\n  --process-control-height: 2.25rem;\r\n}\r\n\r\n/* O card-seção externo mantém suas dimensões; apenas o conteúdo é reduzido. */\r\n.ahp-step-section > .ahp-section-body {\r\n  padding: var(--process-space-4);\r\n}\r\n\r\n#nova-hierarquizacao {\r\n  display: grid;\r\n  gap: var(--process-space-4);\r\n}\r\n\r\n/* Primeiro nível contido. */\r\n#nova-hierarquizacao > .cadastro-card {\r\n  display: grid;\r\n  gap: var(--process-space-3);\r\n  margin: 0;\r\n  padding: var(--process-space-3);\r\n  border-radius: 8px;\r\n  box-shadow: none;\r\n  font-size: 0.9rem;\r\n}\r\n\r\n#nova-hierarquizacao > .cadastro-card > .ahp-subsection-title {\r\n  min-height: auto;\r\n  margin: 0;\r\n  gap: var(--process-space-2);\r\n}\r\n\r\n#nova-hierarquizacao > .cadastro-card > .ahp-subsection-title h2 {\r\n  margin: 0;\r\n  font-size: 0.75rem;\r\n  line-height: 1.25;\r\n}\r\n\r\n#nova-hierarquizacao > .cadastro-card > .ahp-subsection-title > i {\r\n  font-size: 0.8rem;\r\n}\r\n\r\n/* Composição de cores dos cards internos: superfícies claras e neutras; o\r\n   cabeçalho fica em barra clara com texto escuro (abaixo, na hierarquia, do\r\n   cabeçalho escuro do container). Escopo restrito ao formulário. */\r\n#nova-hierarquizacao > .cadastro-card {\r\n  background: #fff;\r\n  border: 1px solid #d8e0e5;\r\n  box-shadow: 0 1px 2px rgba(20, 40, 60, 0.05);\r\n}\r\n\r\n#nova-hierarquizacao > .cadastro-card > .ahp-subsection-title {\r\n  background: #eef3f7;\r\n  color: var(--pli-deep);\r\n  border-bottom: 1px solid #dbe4ea;\r\n}\r\n\r\n#nova-hierarquizacao > .cadastro-card > .ahp-subsection-title i {\r\n  color: var(--pli-blue);\r\n}\r\n\r\n/* Escala única de espaçamento interno. */\r\n#nova-hierarquizacao p,\r\n#nova-hierarquizacao .ahp-info-note {\r\n  margin: 0;\r\n}\r\n\r\n#nova-hierarquizacao .process-grid {\r\n  gap: var(--process-space-3);\r\n}\r\n\r\n#nova-hierarquizacao .process-field {\r\n  gap: var(--process-space-1);\r\n}\r\n\r\n#nova-hierarquizacao label > span {\r\n  font-size: 0.78rem;\r\n  font-weight: 650;\r\n}\r\n\r\n#nova-hierarquizacao input,\r\n#nova-hierarquizacao select {\r\n  min-height: var(--process-control-height);\r\n  padding: 0.4rem 0.6rem;\r\n  font-size: 0.84rem;\r\n}\r\n\r\n#nova-hierarquizacao textarea {\r\n  padding: 0.5rem 0.6rem;\r\n  font-size: 0.84rem;\r\n}\r\n\r\n#nova-hierarquizacao .ahp-info-note {\r\n  gap: var(--process-space-2);\r\n  padding: var(--process-space-2);\r\n  font-size: 0.8rem;\r\n}\r\n\r\n#nova-hierarquizacao .ahp-info-note > i {\r\n  font-size: 0.9rem;\r\n}\r\n\r\n#form-error {\r\n  display: block;\r\n  flex-direction: initial;\r\n  padding: 14px 16px;\r\n  font-size: 0.85rem;\r\n  line-height: 1.5;\r\n}\r\n#form-error .ahp-error-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-weight: 700;\r\n  font-size: 0.95rem;\r\n  margin-bottom: 8px;\r\n}\r\n#form-error .ahp-error-title i {\r\n  font-size: 1rem;\r\n}\r\n#form-error .ahp-error-line {\r\n  margin: 6px 0;\r\n}\r\n#form-error .ahp-error-list {\r\n  margin: 6px 0 6px 22px;\r\n  padding: 0;\r\n}\r\n#form-error .ahp-error-list li {\r\n  margin: 3px 0;\r\n}\r\n\r\n#nova-hierarquizacao .ahp-help-text {\r\n  font-size: 0.78rem;\r\n  line-height: 1.4;\r\n}\r\n\r\n#nova-hierarquizacao .process-actions {\r\n  margin: 0;\r\n  gap: var(--process-space-2);\r\n}\r\n\r\n.hier-register-table {\r\n  font-size: 0.74rem;\r\n}\r\n\r\n.hier-register-table th,\r\n.hier-register-table td {\r\n  text-align: center;\r\n  vertical-align: middle;\r\n  line-height: 1.1;\r\n}\r\n\r\n.hier-register-table th {\r\n  padding: 0.5rem 0.6rem;\r\n  font-size: 0.72rem;\r\n}\r\n\r\n.hier-register-table td {\r\n  height: 1.7rem;\r\n  padding: 0.18rem 0.55rem;\r\n  font-size: 0.74rem;\r\n}\r\n\r\n/* Coluna de matriz + edição inline + modais */\r\n.matriz-link {\r\n  background: none;\r\n  border: none;\r\n  color: var(--pli-blue);\r\n  cursor: pointer;\r\n  font: inherit;\r\n  padding: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.35rem;\r\n}\r\n.matriz-link:hover { text-decoration: underline; }\r\n.hier-register-table .cell-edit {\r\n  width: 100%;\r\n  min-width: 8rem;\r\n  padding: 0.25rem 0.35rem;\r\n  border: 1px solid var(--pli-border);\r\n  border-radius: 0.3rem;\r\n  font: inherit;\r\n}\r\n.hier-register-table tr.is-editing td { background: #fffdf3; }\r\n.json-modal-head-actions { display: flex; align-items: center; gap: 0.5rem; }\r\n\r\n.json-modal-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 10000;\r\n  display: grid;\r\n  place-items: center;\r\n  padding: 1.2rem;\r\n  background: rgba(8, 30, 45, 0.7);\r\n}\r\n.json-modal {\r\n  display: flex;\r\n  width: min(1050px, 96vw);\r\n  max-height: 90vh;\r\n  flex-direction: column;\r\n  border-radius: 12px;\r\n  background: #fff;\r\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\r\n}\r\n.json-modal-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 1rem 1.2rem;\r\n  color: #fff;\r\n  background: var(--pli-deep, #123e56);\r\n  border-radius: 12px 12px 0 0;\r\n}\r\n.json-modal-head h2 { margin: 0; font-size: 1.05rem; }\r\n.json-modal-close {\r\n  width: 2rem;\r\n  height: 2rem;\r\n  border: 1px solid #fff;\r\n  border-radius: 50%;\r\n  color: #fff;\r\n  background: transparent;\r\n}\r\n.json-modal-body { overflow: auto; padding: 1rem; }\r\n.json-tree { width: 100%; border-collapse: collapse; }\r\n.json-tree th,\r\n.json-tree td {\r\n  padding: 0.45rem 0.6rem;\r\n  border-bottom: 1px solid #e4e9ec;\r\n  text-align: left;\r\n  vertical-align: top;\r\n}\r\n.json-tree th { width: 34%; color: var(--pli-deep, #123e56); }\r\n\r\n/* Visualizador de JSON em árvore (lazy) — leve e estilizado */\r\n.jv-root { font-size: 0.8rem; color: #334155; }\r\n.jv-list { list-style: none; margin: 0; padding-left: 1.1rem; border-left: 1px solid var(--pli-border); }\r\n.jv-root.jv-list { padding-left: 0; border-left: none; }\r\n.jv-item { padding: 0.12rem 0; }\r\n.jv-item > details > summary {\r\n  cursor: pointer;\r\n  padding: 0.12rem 0;\r\n  list-style: none;\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 0.35rem;\r\n}\r\n.jv-item > details > summary::-webkit-details-marker { display: none; }\r\n.jv-item > details > summary::before {\r\n  content: \"\\25B8\";\r\n  color: var(--pli-blue);\r\n  transition: transform 0.12s ease;\r\n  display: inline-block;\r\n}\r\n.jv-item > details[open] > summary::before { transform: rotate(90deg); }\r\n.jv-key { font-weight: 600; color: var(--pli-deep); }\r\n.jv-count { color: var(--pli-muted); font-size: 0.72rem; }\r\n.jv-val { color: #334155; overflow-wrap: anywhere; }\r\n\r\n/* Demandas do grupo — objeto por bloco, campos agrupados + mapa */\r\n.demanda-corpo { padding: 0.35rem 0 0.5rem 0.4rem; }\r\n.demanda-grupo { margin: 0.5rem 0 0.7rem; }\r\n.demanda-grupo-titulo {\r\n  margin: 0 0 0.35rem;\r\n  font-family: \"Montserrat\", Verdana, sans-serif;\r\n  font-size: 0.72rem;\r\n  font-weight: 700;\r\n  letter-spacing: 0.04em;\r\n  text-transform: uppercase;\r\n  color: var(--pli-blue);\r\n  border-bottom: 1px solid var(--pli-border);\r\n  padding-bottom: 0.2rem;\r\n}\r\n.demanda-campos { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.25rem 1rem; }\r\n.jv-campo { font-size: 0.8rem; }\r\n.demanda-mapa { height: 220px; margin-top: 0.5rem; border: 1px solid var(--pli-border); border-radius: 8px; overflow: hidden; }\r\n.jv-mapa-aviso { margin: 0; padding: 0.6rem; color: var(--pli-muted); font-size: 0.8rem; }\r\n\r\n.matriz-table-wrap { overflow: auto; max-height: 60vh; }\r\n.matriz-view-table { font-size: 0.72rem; }\r\n.matriz-view-table th,\r\n.matriz-view-table td {\r\n  max-width: 260px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  padding: 0.4rem 0.5rem;\r\n}\r\n\r\n@media (max-width: 700px) {\r\n  .ahp-step-section > .ahp-section-body {\r\n    padding: var(--process-space-3);\r\n  }\r\n\r\n  #nova-hierarquizacao > .cadastro-card {\r\n    padding: var(--process-space-2);\r\n  }\r\n}\r\n",
