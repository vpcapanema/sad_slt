			"type": "shell",
			"command": "git add -A .gitignore 2>$null; Add-Content .gitignore \"`n# Arquivos de trava do Excel (nao versionar)`n~`$*.xlsx\"; git status --short | Select-String 'Matriz'",
			"isBackground": false,
