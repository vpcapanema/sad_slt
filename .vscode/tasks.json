{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SICARD: Iniciar servidor local",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B",
        "-m",
        "uvicorn",
        "api.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8083",
        "--env-file",
        ".env"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Inicia a aplicação no Windows em http://127.0.0.1:8083. Requer as conexões configuradas no .env. Ctrl+C encerra o servidor."
    },
    {
      "label": "SICARD: Verificar servidor local",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B",
        "-c",
        "import urllib.request; u='http://127.0.0.1:8083/api/health/ready'; r=urllib.request.urlopen(u,timeout=15); print('HTTP',r.status); print(r.read().decode('utf-8'))"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Consulta /api/health/ready do servidor já iniciado e exibe o resultado."
    },
    {
      "label": "SICARD: Commit, sincronizar e deploy na VM",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B",
        "-u",
        "${workspaceFolder}/scripts/deploy-task.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": true
      },
      "detail": "Status > commit > fetch/merge/push main > deploy VM com logs > saude da API/banco > navegador externo. Para em qualquer falha."
    }
  ]
}
