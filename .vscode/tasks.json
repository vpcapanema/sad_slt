{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SICARD: Iniciar servidor local",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B",
        "-u",
        "${workspaceFolder}/scripts/start-local-task.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Valida e supervisiona os bancos oficiais da VM, inicia http://127.0.0.1:8083 e abre Edge e Chrome externos com Console detalhado. Ctrl+C encerra servidor e túnel."
    },
    {
      "label": "SICARD: Verificar servidor local",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B",
        "-c",
        "import urllib.request; u='http://127.0.0.1:8083/api/health/ready'; r=urllib.request.urlopen(u,timeout=15); print('HTTP',r.status); print(r.read().decode('utf-8'))"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Consulta /api/health/ready do servidor já iniciado e exibe o resultado."
    },
    {
      "label": "SICARD: Commit, sincronizar e deploy na VM (execução)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B",
        "-u",
        "${workspaceFolder}/scripts/deploy-task.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": true
      },
      "detail": "Status > commit > fetch/merge/push main > deploy VM com logs > saude da API/banco > navegador externo. Para em qualquer falha."
    },
    {
      "label": "SICARD: Atualizar controle de código",
      "type": "shell",
      "command": "echo",
      "args": ["${command:sicardPreview.refreshSourceControl}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": true
      },
      "hide": true,
      "detail": "Atualiza o Source Control e notifica após um deploy concluído."
    },
    {
      "label": "SICARD: Commit, sincronizar e deploy na VM",
      "dependsOn": [
        "SICARD: Commit, sincronizar e deploy na VM (execução)",
        "SICARD: Atualizar controle de código"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": true
      },
      "detail": "Executa commit, sincronização e deploy; depois atualiza o Source Control e exibe notificação."
    },
    {
      "label": "SICARD: Acompanhar comandos do Codex",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-B",
        "-u",
        "${workspaceFolder}/scripts/watch-codex-commands.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": false
      },
      "detail": "Espelha comandos, saidas e codigos de retorno do Codex em um terminal. Somente leitura; nao reexecuta comandos."
    }
  ]
}
