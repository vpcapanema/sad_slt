# Modelo: preserve um .env privado já configurado. Nunca versione credenciais.
# API Windows/manual: 8080. start-dev-codespace.sh usa SICARD_DEV_PORT (padrão 8083).
PORT=8080

# SIGMA — API HTTP (instituições, pessoas)
SIGMA_API_BASE=https://56.125.163.194
SIGMA_HTTP_TIMEOUT=30

# Email SICARD — mesma conta SMTP autorizada do SIGMA, sem chamar sua API.
# Ative somente depois de preencher os valores privados. Não copie o .env
# inteiro do SIGMA; compartilhe somente a configuração SMTP autorizada.
SICARD_EMAIL_ENABLED=false
SICARD_SMTP_HOST=smtp.gmail.com
SICARD_SMTP_PORT=587
SICARD_SMTP_SECURITY=starttls
SICARD_SMTP_USER=
SICARD_SMTP_PASSWORD=
SICARD_EMAIL_FROM=
SICARD_EMAIL_REPLY_TO=
SICARD_SMTP_TIMEOUT=30
# Consulta opcional de notificações: mesma conta SMTP, sempre IMAP sobre TLS.
# Usa SELECT somente-leitura e BODY.PEEK; não marca, move ou exclui mensagens.
SICARD_EMAIL_IMAP_ENABLED=false
SICARD_EMAIL_IMAP_HOST=imap.gmail.com
SICARD_EMAIL_IMAP_PORT=993
SICARD_EMAIL_IMAP_FOLDER=INBOX

# SIGMA — PostgreSQL read-only (login admin → usuarios.usuario, perfil GESTOR)
# Mesmo padrão do PLI-HazardTrack. Copie a senha do .env de lá se já tiver.
SIGMA_POSTGRES_HOST=56.125.163.194
SIGMA_POSTGRES_PORT=5433
SIGMA_POSTGRES_DATABASE=sigma_pli_qr53
SIGMA_POSTGRES_USER=sigma_user
SIGMA_POSTGRES_PASSWORD=
SIGMA_POSTGRES_SSLMODE=disable
# Alternativa: SIGMA_DATABASE_URL=postgresql://sigma_user:senha@56.125.163.194:5433/sigma_pli_qr53?sslmode=disable

# Sessão admin (cookie). Gere: python -c "import secrets; print(secrets.token_hex(32))"
SLT_SESSION_SECRET=

# Banco SLT — produção/desenvolvimento compartilhado no PostgreSQL da VM.
# Com true, reutiliza SIGMA_POSTGRES_HOST/PORT/USER/PASSWORD e conecta em slt_db.
SLT_USE_SIGMA_POSTGRES=true
# Codespace: SLT_USE_SIGMA_POSTGRES=false e DSNs privados SLT_DATABASE_URL
# e SIGMA_DATABASE_URL apontando a 127.0.0.1:15433 pela ponte Windows/SSH.
# No Windows local, os dois DSNs usam o gateway TLS da porta 443, sem túnel SSH.
# Obtenha as credenciais autorizadas; não reutilize a senha fictícia abaixo.
# Consulte documentacao/BANCO_CODESPACE.md. Com true, o DSN SLT abaixo é ignorado.
# Alternativa local para contingência (use SLT_USE_SIGMA_POSTGRES=false):
SLT_DATABASE_URL=postgresql://slt_user:slt_pass@127.0.0.1:5434/slt_db


# Storage do SICARD (SFTPGo) — destino único dos uploads de arquivo local da
# página de bases geoespaciais e da bancada. A aplicação grava pela API de
# usuário do SFTPGo, publicada pelo Nginx em /sicard/storage-api/user/.
# Usuário próprio da aplicação, criado no painel de administração do storage,
# com pasta inicial /sicard e permissões de listar, enviar e criar pastas.
SICARD_STORAGE_API_URL=https://56.125.163.194/sicard/storage-api
SICARD_STORAGE_API_USER=
SICARD_STORAGE_API_PASSWORD=
# No Codespace, scripts/start-storage-codespace.sh apresenta a API existente
# neste caminho, sem manter copia integral das camadas para leitura.
SICARD_STORAGE_DIR=data/storage
# Montagem real do acervo SFTPGo com escrita. Não usar uma pasta local/espelho.
# O servidor recusa iniciar sem esta montagem e sem a pasta temporária existente.
# No Compose estes valores já são definidos; no Windows é necessária montagem
# do storage, não uma pasta criada com o mesmo nome.
SICARD_STORAGE_WRITE_DIR=/app/storage-escrita
SICARD_STORAGE_TEMP_DIR=/app/storage-escrita/temporarios-sicard
# Dados necessários já estão no storage; não copiar a pasta data/ no deploy.
# Referências territoriais: referencias-territoriais/ na API do SFTPGo.
# SICARD_STORAGE_API_VERIFY_TLS=false  # só se o certificado não for verificável
